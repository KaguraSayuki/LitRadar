# 模板单元 —— 用 litradar-daily@<用户名>.service 引用(%i 会被替换)。
# 不要直接拷成 litradar-daily.service:那会让 %i 为空,systemd 拒绝启动。
[Unit]
Description=LitRadar 每日流水线(采集 → 富化 → 排序 → 摘要)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=%i
WorkingDirectory=/srv/Work/LitRadar
# 应用自行读取 .env 与私有凭据；此兼容任务只用于仍由外部调度的实例。
# 使用网页自动更新时须停用对应 timer，不要让两套调度先后执行。
ExecStart=/srv/Work/LitRadar/.venv/bin/python -m litradar.cli run

# 时间窗不写在这里,统一取 config.yaml 的 app.pipeline_window_days ——
# 排序窗口必须 ≥ 抓取窗口,否则抓回来的文献进了库却永远不评分。
# (之前网页按钮单独写死 30 天,就和定时任务的 200 天对不上,见该配置项的注释。)
# 单次运行超时保护(富化要逐条请求,给足时间)
TimeoutStartSec=3600
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=read-only
# 整个文件系统只读,只放开项目目录:数据库、锁文件、邮件收件目录都在 data/,
# 而 interests.yaml(及其备份)就在项目根下 —— 和 web 单元保持同一套边界。
ProtectSystem=strict
ReadWritePaths=/srv/Work/LitRadar
