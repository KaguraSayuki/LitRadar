# 复制成 .env 并填写真实值;切勿提交到版本库
# chmod 600 .env

# DeepSeek(精排 + 摘要)
DEEPSEEK_API_KEY=

# Semantic Scholar API Key(可选,免费)。配上可把限流从 ~1 req/s 提到 1 req/s 专用池
# 申请: https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# easyScholar 密钥(可选)。期刊等级(影响因子 / 中科院分区 / 北核 / CSCD …)
# 是付费专有数据,只有它能提供;不填则整段跳过 —— 卡片上没有那些标签,其余
# 流程照常,不会报错。按次计额,查询结果缓存在 journal_rank 表,不重复消耗。
# 变量名可用 config.yaml 的 journal_rank.api_key_env 改名。
# 申请: https://www.easyscholar.cc/
EASYSCHOLAR_SECRET_KEY=

# IMAP 应用专用密码(Gmail / QQ / 163;不是登录密码)
IMAP_PASSWORD=

# 可选:接口口令(不是账号)。默认只绑 127.0.0.1 时不需要;
# 若把 app.host 改成非回环地址,必须设置 —— 否则 /admin/run/* 会直接拒绝
# 手动触发(fail closed),因为同网段任何人都能烧掉你的 DeepSeek 额度。
# 访问方式:http://<ip>:8090/?k=<token>(也可以放 X-Token 头)
LITRADAR_TOKEN=

# 可选:花钱阶段(默认 rank / summarize / all)的管理员密码哈希。
# 不要手写这一行 —— 运行 `litradar admin-password` 提示输入密码,它会算出
# PBKDF2 哈希并写到这里(只存哈希,不存明文)。设了之后,网页上运行这些阶段
# 会额外弹一次密码输入。
# 与上面的 token 是两件事:token 在 URL 里、长期有效,密码每次输入、用完即忘。
LITRADAR_ADMIN_PASSWORD_HASH=

# 可选:自定义配置文件路径
# LITRADAR_CONFIG=./config.yaml
