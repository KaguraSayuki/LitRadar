# 复制为 .env 并填写实际值；不要提交到版本库。
# Linux / macOS 可执行 chmod 600 .env，Windows 使用文件访问权限控制。

# DeepSeek：LLM 精排、中文摘要与方向性说明。
DEEPSEEK_API_KEY=

# Semantic Scholar：本项目的检索与被引追踪需要此密钥；按 DOI 补全可尝试匿名请求。
# 申请说明见 docs/s2-api-key-application.md；密钥不代表请求可以不受限流约束。
S2_API_KEY=

# easyScholar：可选的期刊等级展示。未填写时跳过查询，不影响其他阶段。
# 查询按刊名缓存；变量名可由 config.yaml 的 journal_rank.api_key_env 指定。
EASYSCHOLAR_SECRET_KEY=

# IMAP 密码或授权码，按邮箱服务商的要求填写；仅 mail.mode=imap 时使用。
IMAP_PASSWORD=

# 接口口令：配置后用于页面和 API 的访问校验。
# Web 仅供本机使用时可留空；经反向代理提供局域网访问时建议设置。
# app.host 为非回环地址且未设口令时，/admin/run/* 会拒绝手动运行。
# 首次访问使用 ?k=<token>，API 也支持 X-Token 请求头。
LITRADAR_TOKEN=

# 网页受保护阶段的管理员密码哈希，由 litradar admin-password 生成并写入。
# 不要在此填写明文密码。修改已有密码后需重启 Web 服务。
LITRADAR_ADMIN_PASSWORD_HASH=

# 可选 OpenAlex 检索密钥，启用 sources.openalex_enabled 时填写。
# OPENALEX_API_KEY=

# 可选：指定 config.yaml 路径，CLI 也可使用 -c 参数。
# LITRADAR_CONFIG=./config.yaml
