# 复制成 .env 并填写真实值;切勿提交到版本库
# chmod 600 .env

# DeepSeek(精排 + 摘要)
DEEPSEEK_API_KEY=

# Semantic Scholar API Key(可选,免费)。配上可把限流从 ~1 req/s 提到 1 req/s 专用池
# 申请: https://www.semanticscholar.org/product/api#api-key-form
S2_API_KEY=

# IMAP 应用专用密码(Gmail / QQ / 163;不是登录密码)
IMAP_PASSWORD=

# 可选:接口口令(不是账号)。默认只绑 127.0.0.1 时不需要;
# 若把 app.host 改成 0.0.0.0,建议设置 —— 否则同网段任何人都能调
# /admin/run/* 花掉你的 DeepSeek 额度。访问方式:http://<ip>:8080/?k=<token>
LITRADAR_TOKEN=

# 可选:自定义配置文件路径
# LITRADAR_CONFIG=./config.yaml
